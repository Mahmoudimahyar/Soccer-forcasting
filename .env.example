# Keep the real .env outside version control. Never paste secrets into Claude Code.

# Live data (optional until their adapters are enabled)
API_FOOTBALL_KEY=
ODDS_API_KEY=
FOOTBALL_DATA_KEY=

# Kalshi: begin with demo credentials only.
KALSHI_ENV=demo
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# Must remain false until you deliberately arm production outside Claude Code.
KALSHI_ENABLE_LIVE_TRADING=false
# Required only for an intentionally unattended live service. Do not put this in git.
KALSHI_LIVE_TRADING_ACK=

# Trading safety. Values are cents/contracts unless stated otherwise.
TRADING_MODE=paper
MAX_ORDER_COST_CENTS=500
MAX_EVENT_EXPOSURE_CENTS=1500
MAX_DAILY_LOSS_CENTS=1000
MAX_OPEN_ORDERS=4
MIN_EDGE_AFTER_UNCERTAINTY=0.04
MAX_MARKET_SPREAD_CENTS=5
MAX_PREDICTION_AGE_SECONDS=30
MAX_MARKET_AGE_SECONDS=10
MIN_MODEL_CONFIDENCE=0.55
